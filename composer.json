{
    "name": "trevorbicewebdesign/mycodelicforest-wordpress",
    "description": "WordPress site: WordPress core, plugins and theme installed by Composer, tested with Codeception.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "config": {
        "vendor-dir": "vendor",
        "allow-plugins": {
            "composer/installers": true
        },
        "preferred-install": "dist",
        "parallel-install": 1,
        "platform": {
            "php": "8.4.0"
        }
    },
    "extra": {
        "installer-paths": {
            "wp-content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "wp-content/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        },
        {
            "type": "vcs",
            "url": "https://github.com/trevorbicewebdesign/akeebabackupwp.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/trevorbicewebdesign/gravityforms.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/trevorbicewebdesign/revslider.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/trevorbicewebdesign/advanced-custom-fields-pro.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/trevorbicewebdesign/spectra-pro.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/trevorbicewebdesign/codeception-mailpit"
        }
    ],
    "require": {
        "roots/wordpress-no-content": "*",
        "trevorbicewebdesign/advanced-custom-fields-pro": "^6.8",
        "trevorbicewebdesign/akeebabackupwp": "*",
        "trevorbicewebdesign/gravityforms": "^3.1",
        "trevorbicewebdesign/revslider": "^7.1",
        "trevorbicewebdesign/spectra-pro": "^1.3",
        "wpackagist-plugin/create-block-theme": "*",
        "wpackagist-plugin/email-address-obfuscation": "*",
        "wpackagist-plugin/enable-turnstile-cloudflare-for-gravity-forms": "*",
        "wpackagist-plugin/google-site-kit": "*",
        "wpackagist-plugin/login-with-google": "*",
        "wpackagist-plugin/loginpress": "*",
        "wpackagist-plugin/members": "*",
        "wpackagist-plugin/really-simple-ssl": "*",
        "wpackagist-plugin/redirection": "*",
        "wpackagist-plugin/svg-support": "*",
        "wpackagist-plugin/ultimate-addons-for-gutenberg": "*",
        "wpackagist-plugin/ultimate-faqs": "*",
        "wpackagist-plugin/wordfence": "*",
        "wpackagist-plugin/wp-mail-smtp": "*",
        "wpackagist-plugin/xml-sitemap-generator-for-google": "*",
        "wpackagist-theme/spectra-one": "*"
    },
    "require-dev": {
        "lucatume/wp-browser": "^4.0",
        "codeception/module-rest": "^3.3",
        "league/factory-muffin": "^3.0",
        "league/factory-muffin-faker": "^2.0",
        "10up/wp_mock": "*",
        "trevorbicewebdesign/codeception-mailpit": "*"
    },
    "autoload": {
        "psr-4": {
            "Helper\\": "tests/_support/Helper/"
        }
    },
    "scripts": {
        "test": "codecept run integration",
        "post-install-cmd": "@php bin/install-core.php",
        "post-update-cmd": "@php bin/install-core.php"
    }
}
